# URL base da API backend
# Em desenvolvimento local, aponta para o backend rodando em localhost:3001
# Em produção (Vercel), deixe vazio ou remova — usa paths relativos automaticamente
VITE_API_URL=http://localhost:3001

# Firebase Configuration
# Crie um projeto em https://console.firebase.google.com
# Ative Authentication (Email/Password) e Firestore Database
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
