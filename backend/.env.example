# Porta do servidor
PORT=3001

# NASA FIRMS API Key (opcional — obtenha em https://firms.modaps.eosdis.nasa.gov/api/area/)
# Transaction limit: 5000 transactions / 10 minutes
NASA_FIRMS_API_KEY=

# Fonte de dados FIRMS: VIIRS_SNPP_NRT ou MODIS_NRT
NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT

# Origem permitida para CORS (URL do frontend)
CORS_ORIGIN=http://localhost:5173

# ============================================
# Firebase Admin SDK — Escolha UMA das opções:
# ============================================

# OPÇÃO 1 (RECOMENDADO - Desenvolvimento Local):
# Baixe o arquivo JSON da Service Account do Firebase Console:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Salve como: backend/guarda-agro-firebase-adminsdk-fbsvc-XXXXX.json
# O código detecta automaticamente o arquivo!

# OPÇÃO 2 (Vercel/Produção):
# Cole o conteúdo completo do JSON em uma linha (usado no Vercel)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# OPÇÃO 3 (Fallback - Variáveis individuais):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
